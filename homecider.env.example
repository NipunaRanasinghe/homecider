# HomeCider configuration. `homecider init` copies this to ~/.config/homecider/homecider.env.
# Every value is optional; the defaults are shown. Paths must not contain spaces.

# Modules to set up. core is required. Optional: media, photos, downloads (opt-in; docs/downloads.md),
# backup (docs/backup.md), dashboard (opt-in; docs/dashboard.md).
MODULES="core media photos"

# Time zone for containers and logs (init fills in this Mac's zone).
TZ=Etc/UTC

# Server owner account. Default: the user running homecider.
# HC_USER=

# Where app data lives. Default: ~/Library/HomeCider
# DATA_DIR=

# media: Jellyfin reads this folder (Movies/ and Shows/ are created). The Jellyfin user can read only this
# folder inside your home; other readable home folders are made private. Default: ~/Media
# MEDIA_DIR=
# Hidden user/group ID for Jellyfin. Change only if 450 is taken.
# JELLYFIN_UID=450

# photos: Immich. Version is pinned; read the release notes before changing it, then run homecider apply.
# IMMICH_VERSION=v3.4.1
# PHOTOS_DIR=           # default ~/Photos/immich
# IMMICH_DB_DIR=        # default $DATA_DIR/immich-postgres

# downloads: doctor and apply stop until this is true. Read "Legal use" in docs/downloads.md first.
# DOWNLOADS_ACCEPT_RESPONSIBILITY=false
# downloads: where the apps keep their settings. Default: $DATA_DIR/downloads
# DOWNLOADS_CONFIG_DIR=
# vpn  = torrent traffic only through a VPN (nothing is downloaded until one is configured)
# home = through your home connection; your IP is visible to every peer. Also needs DOWNLOADS_ALLOW_HOME_IP=true.
# DOWNLOADS_NETWORK=vpn
# DOWNLOADS_ALLOW_HOME_IP=false

# backup: restic repository, e.g. s3:https://s3.eu-central-003.backblazeb2.com/my-bucket
# Secrets go in secrets.env via `homecider secret set`: RESTIC_PASSWORD, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
# BACKUP_REPOSITORY=
# BACKUP_HOUR=2
# VAULT_DIR=            # default ~/Vault; encrypted images here are backed up as they are
# BACKUP_EXTRA_PATHS=   # space-separated

# Docker (OrbStack) VM memory limit in MiB.
# DOCKER_MEMORY_MIB=6144

# Alerts (ntfy.sh push messages). A random topic is generated on first apply; subscribe to it in the ntfy app.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh   # or your own ntfy server
# DISK_ALERT_PCT=85
# Laptops only: clean shutdown on battery at this charge.
# BATTERY_SHUTDOWN_PCT=15

# Weekly update job: weekday (0 = Sunday) and hour.
# UPDATE_WEEKDAY=0
# UPDATE_HOUR=4
# true = upgrade every Homebrew app on the Mac; false = only HomeCider's (OrbStack, Jellyfin, restic).
# UPDATE_ALL_HOMEBREW=false
# Remove dangling Docker images (untagged and unused) after updates.
# UPDATE_PRUNE_IMAGES=true
