#!/bin/sh
# homecider: turn any Mac (Apple Silicon) into a private home server.
#   homecider init     create homecider.env from the example
#   homecider apply [--dry-run]   set up every enabled module (asks for sudo once); safe to re-run
#   homecider status   show services, jobs, disk and battery
#   homecider doctor   check prerequisites and configuration
#   homecider uninstall   stop services and remove system changes; data is kept
#   homecider leaktest check that downloads go through the VPN (downloads module)
#   homecider backup now | snapshots | restore-test     (backup module)
#   homecider secret set NAME    store a secret in secrets.env without echoing it
#   homecider vault create | open | close | list   encrypted disk images for archives
set -eu
# Follow symlinks (Homebrew links bin/homecider into /opt/homebrew/bin).
HC_ROOT="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
HC_VERSION=0.1.0-dev

usage() { sed -n '2,11p' "$HC_ROOT/bin/homecider" | sed 's/^# //'; }

cmd_init() {
  cfg="${HC_CONFIG:-$HOME/.config/homecider/homecider.env}"
  if [ -f "$cfg" ]; then echo "$cfg already exists; edit it, then run: homecider apply"; return; fi
  mkdir -p "$(dirname "$cfg")"
  sed "s#^TZ=.*#TZ=$(readlink /etc/localtime | sed 's#.*/zoneinfo/##')#" "$HC_ROOT/homecider.env.example" > "$cfg"
  chmod 600 "$cfg"
  echo "Wrote $cfg. Review MODULES and paths, then run: homecider apply"
}

cmd_doctor() {
  . "$HC_ROOT/lib/common.sh"
  ok=0
  pass() { printf '  ok    %s\n' "$*"; }
  fail() { printf '  FAIL  %s\n' "$*"; ok=1; }
  note() { printf '  note  %s\n' "$*"; }
  [ "$(uname -m)" = arm64 ] && pass "Apple Silicon" || fail "not Apple Silicon (unsupported)"
  v="$(sw_vers -productVersion)"; pass "macOS $v"
  [ "$(id -un)" = "$HC_USER" ] && pass "running as $HC_USER" || fail "run as $HC_USER, not $(id -un)"
  fdesetup status | grep -q "On" && pass "FileVault on" || note "FileVault off: a stolen Mac exposes all data"
  command -v brew >/dev/null && pass "Homebrew" || fail "Homebrew missing: https://brew.sh"
  grep -q 'ssh-' "$HC_HOME/.ssh/authorized_keys" 2>/dev/null && pass "SSH key in authorized_keys" ||
    fail "no SSH key in ~/.ssh/authorized_keys (apply turns off password login)"
  nc -z -G 2 localhost 22 2>/dev/null && pass "Remote Login (SSH) on" || fail "Remote Login (SSH) off: System Settings > General > Sharing"
  for m in $MODULES; do [ -d "$HC_ROOT/modules/$m" ] && pass "module $m" || fail "unknown module $m"; done
  has_module core || fail "MODULES must include core"
  if uses_docker; then
    [ -x /Applications/OrbStack.app/Contents/MacOS/xbin/docker ] && pass "OrbStack" || note "OrbStack will be installed by apply"
  fi
  # Services listen on every address; with a public IPv6 address only the router keeps them off the internet.
  v6="$(ifconfig | awk '$1 == "inet6" && $2 ~ /^[23]/ && !/deprecated/ {print $2; exit}')"
  [ -n "$v6" ] && note "public IPv6 address $v6: your router must block incoming IPv6. Check from mobile data:" \
    "http://[$v6]:8096 must time out (README: Before you install)"
  has_battery && note "battery present: low-battery shutdown at ${BATTERY_SHUTDOWN_PCT}%; set the charge limit in System Settings > Battery"
  if has_module downloads; then
    [ "$DOWNLOADS_ACCEPT_RESPONSIBILITY" = true ] && pass "downloads: responsibility accepted" ||
      fail "downloads: set DOWNLOADS_ACCEPT_RESPONSIBILITY=true after reading docs/downloads.md (Legal use)"
    [ "$DOWNLOADS_NETWORK" = vpn ] && note "downloads: VPN-only; nothing downloads until a VPN is configured" ||
      note "downloads: home connection; your IP is visible to peers"
  fi
  return $ok
}

cmd_apply() {
  . "$HC_ROOT/lib/common.sh"
  [ "$(id -u)" != 0 ] || die "run apply as your user, not with sudo (it asks for sudo itself)"
  case "${1:-}" in "") dry=false ;; --dry-run) dry=true ;; *) die "usage: homecider apply [--dry-run]" ;; esac
  if ! cmd_doctor; then
    $dry || die "fix the FAIL items above first"
    echo "apply would stop here until the FAIL items above are fixed."
  fi

  casks=""; uses_docker && casks="$casks orbstack"; has_module media && casks="$casks jellyfin"
  roots=""; for m in $MODULES; do [ -f "$HC_ROOT/modules/$m/root.sh" ] && roots="$roots $m"; done
  # dashboard runs last: it reads the API keys the other modules store.
  users=""; for m in $MODULES; do [ "$m" != dashboard ] && [ -f "$HC_ROOT/modules/$m/user.sh" ] && users="$users $m"; done
  has_module dashboard && users="$users dashboard"

  if $dry; then
    # Prints the first comment line of each script that apply would run. Changes nothing.
    echo "Dry run. apply would:"
    for c in $casks; do brew list --cask "$c" >/dev/null 2>&1 || echo "  install $c (Homebrew cask)"; done
    for m in $roots; do echo "  as root: $(sed -n '2s/^# //p' "$HC_ROOT/modules/$m/root.sh")"; done
    for m in $users; do echo "  as $HC_USER: $(sed -n '2s/^# //p' "$HC_ROOT/modules/$m/user.sh")"; done
    echo "Nothing was changed. Full list: README, What apply changes on your Mac."
    return
  fi

  mkdir -p "$HC_STATE" "$HC_LOGS"; chmod 700 "$HC_STATE"
  for c in $casks; do brew list --cask "$c" >/dev/null 2>&1 || brew install --cask "$c"; done
  log "root steps:$roots (sudo)"
  sudo sh -c 'for m in '"$roots"'; do sh "'"$HC_ROOT"'/modules/$m/root.sh" || exit 1; done'
  for m in $users; do sh "$HC_ROOT/modules/$m/user.sh"; done
  log "apply finished"
}

cmd_status() {
  . "$HC_ROOT/lib/common.sh"
  up() { curl -fsS -m 5 -o /dev/null "$1" 2>/dev/null && echo up || echo DOWN; }
  echo "HomeCider $HC_VERSION  ·  modules: $MODULES"
  echo "Disk: $(df -h /System/Volumes/Data | awk 'NR==2{print $5" used, "$4" free"}')"
  has_battery && echo "Battery: $(pmset -g batt | grep -Eo '[0-9]+%;[^;]*' | head -1)"
  echo "Jobs:"
  jobs="alerts update"; has_module backup && jobs="$jobs backup"
  for j in $jobs; do printf '  %-12s %s\n' "$j" "$(launchctl print "gui/$HC_UID/$HC_LABEL.$j" >/dev/null 2>&1 && echo loaded || echo MISSING)"; done
  has_battery && printf '  %-12s %s\n' low-battery "$(launchctl print "system/$HC_LABEL.low-battery" >/dev/null 2>&1 && echo loaded || echo MISSING)"
  echo "Services:"
  has_module media && printf '  %-12s %s  http://localhost:8096\n' jellyfin "$(up http://localhost:8096/health)"
  has_module photos && printf '  %-12s %s  http://localhost:2283\n' immich "$(up http://localhost:2283/api/server/ping)"
  has_module dashboard && printf '  %-12s %s  http://localhost:3000\n' dashboard "$(up http://localhost:3000)"
  if uses_docker; then
    echo "Containers:"
    docker ps -a --format '{{.Names}}\t{{.Status}}' 2>/dev/null | sed 's/^/  /' || echo "  docker not responding"
  fi
  active=""
  for a in "$HC_STATE"/alerts/*; do
    [ -e "$a" ] || continue
    case "$(basename "$a")" in immich-*) ;; *) active="$active $(basename "$a")" ;; esac
  done
  has_module backup && echo "Last backup: $( [ -f "$HC_STATE/backup-ok" ] && date -r "$(cat "$HC_STATE/backup-ok")" '+%Y-%m-%d %H:%M' || echo never)"
  echo "Active alerts: ${active:-none}"
}

cmd_secret() {
  [ "${1:-}" = set ] && [ -n "${2:-}" ] || die "usage: homecider secret set NAME"
  . "$HC_ROOT/lib/common.sh"
  printf 'Value for %s (not shown): ' "$2"; stty -echo; read -r value; stty echo; echo
  [ -n "$value" ] || die "empty value"
  set_secret "$2" "$value"; echo "saved $2 in $HC_SECRETS"
}

cmd_backup() {
  . "$HC_ROOT/lib/common.sh"
  has_module backup || die "add backup to MODULES first"
  case "${1:-}" in
    now) sh "$HC_ROOT/modules/backup/run.sh" ;;
    snapshots) . "$HC_ROOT/modules/backup/env.sh"; restic snapshots ;;
    restore-test) sh "$HC_ROOT/modules/backup/restore-test.sh" ;;
    *) die "usage: homecider backup now | snapshots | restore-test" ;;
  esac
}

case "${1:-help}" in
  init) cmd_init ;;
  apply) shift; cmd_apply "$@" ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  uninstall) sh "$HC_ROOT/modules/core/uninstall.sh" ;;
  leaktest) sh "$HC_ROOT/modules/downloads/leak-test.sh" ;;
  backup) shift; cmd_backup "$@" ;;
  secret) shift; cmd_secret "$@" ;;
  vault) shift; sh "$HC_ROOT/modules/vault/vault.sh" "$@" ;;
  version|--version) echo "homecider $HC_VERSION" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
