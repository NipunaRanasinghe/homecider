# photos manifest: loaded by lib/common.sh; MOD_* fields are documented in CONTRIBUTING.md (Adding a module).
# shellcheck shell=sh disable=SC2034
: "${PHOTOS_DIR:=$HC_HOME/Photos/immich}"
: "${IMMICH_DB_DIR:=$DATA_DIR/immich-postgres}"
: "${IMMICH_VERSION:=v3.4.1}"

MOD_TITLE=Immich
MOD_STATUS="immich http://localhost:2283 /api/server/ping"
MOD_ALERT=yes
MOD_COMPOSE=yes
MOD_RELEASE="immich-app/immich IMMICH_VERSION"
# Photos, with Immich's own daily database dumps in backups/. Not backed up: thumbnails and transcoded video
# (regenerated) and the live Postgres folder (unsafe to copy while running).
MOD_BACKUP_PATHS="$PHOTOS_DIR"
MOD_BACKUP_EXCLUDES="$PHOTOS_DIR/thumbs $PHOTOS_DIR/encoded-video $IMMICH_DB_DIR"
MOD_KEPT="$PHOTOS_DIR"
