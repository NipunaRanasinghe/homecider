# downloads manifest: loaded by lib/common.sh; MOD_* fields are documented in CONTRIBUTING.md (Adding a module).
# shellcheck shell=sh disable=SC2034
: "${DOWNLOADS_CONFIG_DIR:=$DATA_DIR/downloads}"
: "${DOWNLOADS_NETWORK:=vpn}"
: "${DOWNLOADS_ALLOW_HOME_IP:=false}"
: "${DOWNLOADS_ACCEPT_RESPONSIBILITY:=false}"

MOD_COMPOSE=yes
MOD_BACKUP_PATHS="$DOWNLOADS_CONFIG_DIR"
