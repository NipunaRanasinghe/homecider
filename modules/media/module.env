# media manifest: loaded by lib/common.sh; MOD_* fields are documented in CONTRIBUTING.md (Adding a module).
# shellcheck shell=sh disable=SC2034
: "${MEDIA_DIR:=$HC_HOME/Media}"
: "${JELLYFIN_UID:=450}"

MOD_TITLE=Jellyfin
MOD_STATUS="jellyfin http://localhost:8096 /health"
MOD_ALERT=yes
MOD_KEPT="$MEDIA_DIR, /Library/Application Support/jellyfin"
